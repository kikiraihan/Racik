# ---- Backend Racik ----
APP_ADDR=:8080
DATABASE_URL=postgres://racik:racik@localhost:5432/racik?sslmode=disable
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
AI_TIMEOUT_SEC=300

# ---- Konektor AI kenari.id (OpenAI-compatible) ----
KENARI_BASE_URL=https://kenari.id/v1
# Buat di dashboard kenari.id -> API Keys (format kn-..., hanya tampil sekali)
KENARI_API_KEY=
# Id model harus PERSIS seperti di https://kenari.id/v1/models (publik).
# Saat start, backend mencocokkan model di bawah dengan daftar itu dan
# menulis PERINGATAN di log kalau ada yang tidak dikenal.
# Model untuk menyusun layout/copy. Akhiran ":free" = gratis (dibatasi per menit/hari);
# model reasoning bisa menghabiskan max_tokens untuk berpikir — pilih model non-reasoning.
KENARI_TEXT_MODEL=claude-sonnet-5-5
KENARI_TEXT_MODELS=claude-sonnet-5-5,claude-haiku-5-5,gpt-oss-120b,deepseek-v4-flash,step-3-7-flash:free
# Model gambar: GPT Image / Google Nano Banana. Semua model gambar berbayar per gambar
# (top up saldo via QRIS di dashboard kenari).
KENARI_IMAGE_MODEL=gpt-image-2
KENARI_IMAGE_MODELS=gpt-image-2,nano-banana-2,nano-banana-2-lite
