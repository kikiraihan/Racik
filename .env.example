# ---- Backend Racik ----
APP_ADDR=:8080
DATABASE_URL=postgres://racik:racik@localhost:5432/racik?sslmode=disable
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
AI_TIMEOUT_SEC=180

# ---- Konektor AI kenari.id (OpenAI-compatible) ----
KENARI_BASE_URL=https://kenari.id/v1
KENARI_API_KEY=
# Model untuk menyusun layout/copy (Claude)
KENARI_TEXT_MODEL=claude-sonnet-4-5
KENARI_TEXT_MODELS=claude-sonnet-4-5,claude-opus-4-1,gpt-5
# Model gambar: Google Nano Banana / GPT Image
KENARI_IMAGE_MODEL=gemini-2.5-flash-image
KENARI_IMAGE_MODELS=gemini-2.5-flash-image,gpt-image-1
