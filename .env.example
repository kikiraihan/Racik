# ---- Docker / deploy (dibaca docker compose, lihat DEPLOY.md) ----
# Port di localhost (VPS) tempat frontend dipublish; nginx host proxy_pass ke sini.
# VPS ini dipakai bareng app lain (katilidev 8082, our-life-planner 8090) — cek port
# bebas dengan: ss -tlnp | grep LISTEN
APP_PORT=8091
# Password user Postgres "racik" di container db. Production: isi dengan
# `openssl rand -hex 24` SEBELUM `docker compose up` pertama (hanya berlaku saat
# volume db pertama kali dibuat).
DB_PASSWORD=racik
# Port host untuk db / Elasticsearch, hanya di 127.0.0.1. Kosong = port acak (tidak
# bentrok dengan app lain). Isi DB_HOST_PORT=5432 kalau backend dijalankan lokal
# dengan `go run` dan db-nya dari docker compose.
DB_HOST_PORT=
ES_HOST_PORT=
# Heap Elasticsearch. RAM VPS mepet? turunkan ke -Xms256m -Xmx256m.
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ---- Backend Racik ----
APP_ADDR=:8080
DATABASE_URL=postgres://racik:racik@localhost:5432/racik?sslmode=disable
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
AI_TIMEOUT_SEC=300

# ---- Akses admin ----
# Email di sini otomatis ber-role admin (saat start, daftar, dan login). Pisahkan dengan koma.
ADMIN_EMAILS=admin@racik.local
# Opsional: buat akun admin untuk email PERTAMA di atas kalau belum terdaftar.
# Ganti password setelah login pertama (atau kosongkan dan daftar manual dengan email admin).
ADMIN_PASSWORD=

# ---- Login Google (Sign in / Sign up with Google) ----
# OAuth Client ID tipe "Web application" dari Google Cloud Console → APIs & Services →
# Credentials. Tambahkan origin frontend (mis. http://localhost:3000 dan
# https://racik.katili.dev) di "Authorized JavaScript origins". Tidak perlu client secret.
# Kosong = tombol Google tidak ditampilkan. Boleh lebih dari satu, pisahkan koma
# (client ID pertama yang dipakai tombol di frontend).
GOOGLE_CLIENT_ID=

# ---- Tarif AI (nilai awal; selanjutnya diatur admin di menu Konfigurasi Harga) ----
# Harga ke user = harga vendor + markup %. Model gratis di vendor = tarif flat per hit (Rp).
PRICE_MARKUP_PERCENT=5
PRICE_FREE_HIT=100

# ---- System log (Elasticsearch) ----
# Activity user (login, hit model AI, aksi admin) & request ke vendor AI.
# Kosong = log ditulis ke stdout sebagai JSON per baris.
LOG_ES_URL=http://localhost:9200
# Isi salah satu bila Elasticsearch memakai security (Elastic Cloud / xpack.security aktif).
LOG_ES_USER=
LOG_ES_PASSWORD=
LOG_ES_API_KEY=
# Index: <prefix>-activity-YYYY.MM dan <prefix>-vendor-YYYY.MM
LOG_INDEX_PREFIX=racik
# Retensi via ILM: index log dihapus setelah N hari (0 = simpan selamanya)
LOG_RETENTION_DAYS=90

# ---- AI API Call Log (PostgreSQL, Panel admin → AI API Call Log) ----
# Setiap request HTTP ke vendor AI: model, status, latensi, token, biaya. Selalu aktif.
# Simpan ringkasan body request & response (gambar base64 tidak disimpan)
AI_CALL_LOG_BODIES=true
# Baris log dihapus setelah N hari (0 = simpan selamanya)
AI_CALL_LOG_RETENTION_DAYS=30

# ---- Konektor AI kenari.id (OpenAI-compatible) ----
KENARI_BASE_URL=https://kenari.id/v1
# Buat di dashboard kenari.id -> API Keys (format kn-..., hanya tampil sekali)
KENARI_API_KEY=
# Id model harus PERSIS seperti di https://kenari.id/v1/models (publik).
# Saat start, backend mencocokkan model di bawah dengan daftar itu dan
# menulis PERINGATAN di log kalau ada yang tidak dikenal.
# Model untuk menyusun layout/copy. Akhiran ":free" = gratis (dibatasi per menit/hari);
# model reasoning bisa menghabiskan max_tokens untuk berpikir — pilih model non-reasoning.
KENARI_TEXT_MODEL=claude-sonnet-5-5
KENARI_TEXT_MODELS=claude-sonnet-5-5,claude-haiku-5-5,gpt-oss-120b,deepseek-v4-flash,step-5-preview:free
# Model gambar: GPT Image / Google Nano Banana. Semua model gambar berbayar per gambar
# (top up saldo via QRIS di dashboard kenari).
KENARI_IMAGE_MODEL=gpt-image-2
KENARI_IMAGE_MODELS=gpt-image-2,nano-banana-2,nano-banana-2-lite

# ---- Provider AI lain (sama dengan katilidev) ----
# Provider aktif kalau API key-nya diisi. Modelnya muncul di dropdown Panel admin sebagai
# "<provider>:<model>". Kosongkan key provider yang tidak dipakai.
#
# Model default lintas provider (opsional), format "<provider>:<model>".
# Kosong = model kenari di atas; kalau kenari tidak aktif, model pertama provider aktif.
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

# Anthropic (Claude API langsung) — teks
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Groq — teks (llama-3.x sudah dimatikan Groq untuk akun free; pakai GPT-OSS)
GROQ_API_KEY=
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# NVIDIA NIM (build.nvidia.com) — satu key untuk teks & gambar
NVIDIA_API_KEY=
NVIDIA_TEXT_MODELS=nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_IMAGE_MODELS=black-forest-labs/flux.2-klein-4b,black-forest-labs/flux.1-dev
NVIDIA_IMAGE_STEPS=4

# Agnes AI — teks & gambar (paket gratis, dibatasi RPM)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODELS=agnes-3.0-flash,agnes-2.5-flash
AGNES_IMAGE_MODELS=agnes-image-2.5-flash,agnes-image-2.1-flash

# OpenRouter — gambar (lewat chat completions) & teks opsional
# Model lain bisa ditambah dari Panel admin → Konfigurasi AI → Katalog model OpenRouter (tanpa restart).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODELS=
OPENROUTER_IMAGE_MODELS=black-forest-labs/flux.2-flex

# Hugging Face Inference — gambar
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/models
HUGGINGFACE_IMAGE_MODELS=black-forest-labs/FLUX.1-schnell

# Pollinations — gambar, gratis tanpa key (true untuk mengaktifkan)
POLLINATIONS_ENABLED=false
POLLINATIONS_IMAGE_MODELS=flux
